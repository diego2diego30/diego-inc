# Copy to deploy/.env on the VPS and fill in real values. Never commit
# deploy/.env -- it's gitignored. Nothing in this repo reads a fallback
# placeholder for these; hermes/config.py raises MissingConfigError
# instead (execution-plan.md Section B instruction 4: request missing
# config explicitly, don't fabricate).

# --- Telegram bridge (Section 4/6) ---
# Create a bot via @BotFather, then message it once and read the chat id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude Code headless auth (Section 5: Agent SDK credit, separate
# from your interactive Pro plan) ---
# Either set ANTHROPIC_API_KEY, or run `claude setup-token` inside the
# container/VPS once interactively and let it persist its own credential
# store -- see Claude Code docs for headless auth options.
ANTHROPIC_API_KEY=

# --- Section 2 hard limits -- REQUIRED before any gate past Backtest.
# These defaults (in hermes/config.py) are conservative placeholders;
# review and override them here with numbers you actually intend to run.
DAILY_MAX_LOSS_PCT=2.0
MAX_POSITION_SIZE_PCT=5.0
MAX_OPEN_POSITIONS=5
CIRCUIT_BREAKER_CONSECUTIVE_LOSSES=3

# --- Per-role model overrides (Section 5 cost control) ---
# MODEL_ANALYST=claude-haiku-4-5-20251001
# MODEL_BULL=claude-haiku-4-5-20251001
# MODEL_BEAR=claude-haiku-4-5-20251001
# MODEL_TRADER=claude-sonnet-5
# MODEL_RISK=claude-sonnet-5
# MODEL_PM=claude-sonnet-5

# --- Market data (Section 4) ---
# mcp_servers/market_data/server.py -- real Alpaca Market Data API keys.
# Market-data-only scope; no brokerage/trading permission needed.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Accounts, read-only (Section 4) ---
# mcp_servers/accounts/server.py -- Plaid. See mcp_servers/accounts/README.md
# for the one-time Plaid Link setup (requires Diego's own bank/brokerage
# login; cannot be automated). Read-only by construction -- no broker's
# real trading/transfer API is wired into this repo anywhere; see
# hermes/execution_guard.py.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=development
PLAID_ACCESS_TOKEN_WF=
PLAID_ACCESS_TOKEN_FIDELITY=

# --- Robinhood, read-only account visibility (Section 4) ---
# Official Robinhood agentic-trading MCP server URL, from a dedicated
# Robinhood account Diego creates himself with its own budget cap (see
# https://robinhood.com/us/en/agentic-trading/). Only read/view MCP tool
# names are ever added to ROLE_ALLOWED_TOOLS -- the order-placement tool
# this server also exposes is never allowlisted for any role.
ROBINHOOD_MCP_URL=

# --- Section 5 cost control -- hard spend caps (hermes/cost.py) ---
# A bug in the cron loop hits these ceilings, not an unbounded bill.
# Defaults below are sized around the plan's own daily-screener estimate
# (~$5-15/mo) with headroom, inside the $20/mo Agent SDK credit.
MONTHLY_USD_CAP=20.0
PER_RUN_USD_CAP=2.0
MAX_RUNS_PER_DAY=4
