# Copy to deploy/.env on the VPS and fill in real values. Never commit
# deploy/.env -- it's gitignored. Nothing in this repo reads a fallback
# placeholder for these; hermes/config.py raises MissingConfigError
# instead (execution-plan.md Section B instruction 4: request missing
# config explicitly, don't fabricate).

# --- Telegram bridge (Section 4/6) ---
# Create a bot via @BotFather, then message it once and read the chat id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude Code headless auth (Section 5: Agent SDK credit, separate
# from your interactive Pro plan) ---
# Either set ANTHROPIC_API_KEY, or run `claude setup-token` inside the
# container/VPS once interactively and let it persist its own credential
# store -- see Claude Code docs for headless auth options.
ANTHROPIC_API_KEY=

# --- Section 2 hard limits -- REQUIRED before any gate past Backtest.
# These defaults (in hermes/config.py) are conservative placeholders;
# review and override them here with numbers you actually intend to run.
DAILY_MAX_LOSS_PCT=2.0
MAX_POSITION_SIZE_PCT=5.0
MAX_OPEN_POSITIONS=5
CIRCUIT_BREAKER_CONSECUTIVE_LOSSES=3

# --- Per-role model overrides (Section 5 cost control) ---
# MODEL_ANALYST=claude-haiku-4-5-20251001
# MODEL_BULL=claude-haiku-4-5-20251001
# MODEL_BEAR=claude-haiku-4-5-20251001
# MODEL_TRADER=claude-sonnet-5
# MODEL_RISK=claude-sonnet-5
# MODEL_PM=claude-sonnet-5

# --- Market data / broker (Section 4) ---
# Not yet wired to a real provider -- mcp_servers/market_data/server.py
# is a mock stub. Add real provider credentials here once Diego picks one.
# MARKET_DATA_API_KEY=
# BROKER_API_KEY=
# BROKER_API_SECRET=
